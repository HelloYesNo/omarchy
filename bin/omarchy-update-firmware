#!/bin/bash

# Update system firmware using fwupd. Ensures the fwupd EFI binary is installed
# in the ESP so UEFI capsule updates work with the Limine bootloader.

set -e
echo -e "\e[32mUpdate Firmware\e[0m"

if omarchy-cmd-missing fwupdmgr; then
  omarchy-pkg-add fwupd
fi

if [[ -d /sys/firmware/efi ]] && [[ -f /usr/lib/fwupd/efi/fwupdx64.efi ]]; then
  if [[ -d /boot/EFI/arch ]]; then
    sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/EFI/arch/fwupdx64.efi
  elif [[ -d /boot/EFI/fedora ]]; then
    sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/EFI/fedora/fwupdx64.efi
  elif [[ -d /boot/efi/EFI/fedora ]]; then
    sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/efi/EFI/fedora/fwupdx64.efi
  elif [[ -d /boot/efi/EFI/arch ]]; then
    sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/efi/EFI/arch/fwupdx64.efi
  else
    sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/EFI/fwupdx64.efi
  fi
fi

fwupdmgr refresh --force
sudo fwupdmgr update
