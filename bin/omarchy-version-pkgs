#!/bin/bash

if [[ -f /var/log/pacman.log ]]; then
  date -d "$(grep upgraded /var/log/pacman.log | tail -1 | sed -E 's/\[([^]]+)\].*/\1/')" "+%A, %B %d %Y at %H:%M"
elif [[ -f /var/log/dnf.log ]]; then
  date -d "$(grep 'Upgraded:\|Installed:' /var/log/dnf.log | tail -1 | sed -E 's/^([^ ]+ [^ ]+ [^ ]+).*/\1/')" "+%A, %B %d %Y at %H:%M" 2>/dev/null || echo "Unknown"
else
  echo "Unknown"
fi
