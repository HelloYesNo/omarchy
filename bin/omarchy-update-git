#!/bin/bash

set -e

echo -e "\e[32mUpdate Omarchy\e[0m"

GIT_DIR="$OMARCHY_PATH"

# On some installs (e.g. Fedora), OMARCHY_PATH may be a flat copy, not a git clone.
# Search for the actual git repo nearby.
if [[ ! -d $GIT_DIR/.git ]]; then
  if [[ -d $HOME/omarchy/.git ]]; then
    GIT_DIR="$HOME/omarchy"
  elif git -C "$(dirname "$OMARCHY_PATH")" rev-parse --is-inside-work-tree &>/dev/null; then
    GIT_DIR="$(git -C "$(dirname "$OMARCHY_PATH")" rev-parse --show-toplevel)"
  else
    echo "Omarchy not installed as a git repo — skipping git update." >&2
    exit 0
  fi
fi

git -C "$GIT_DIR" pull --autostash

# If the git repo isn't the omarchy install dir, sync changes
if [[ $GIT_DIR != "$OMARCHY_PATH" ]]; then
  rsync -a --exclude=.git "$GIT_DIR/" "$OMARCHY_PATH/"
  chmod +x "$OMARCHY_PATH"/bin/* 2>/dev/null || true
fi

git -C "$GIT_DIR" --no-pager diff --check || git -C "$GIT_DIR" reset --merge
