#!/bin/bash

rfkill unblock bluetooth 2>/dev/null || true

if [[ -x ~/.local/bin/bluetui ]]; then
  BLUETUI=~/.local/bin/bluetui
elif [[ -x ~/.cargo/bin/bluetui ]]; then
  BLUETUI=~/.cargo/bin/bluetui
else
  BLUETUI=bluetui
fi

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.bluetui -e "$BLUETUI"
